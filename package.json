{
  "name": "withings-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP server exposing Withings health data to Claude",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
